{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "devCommand": "npm run dev"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "routes": [
        {
          "src": "/api/(.*)",
          "dest": "server.js"
        }
      ]
    }
  }
}